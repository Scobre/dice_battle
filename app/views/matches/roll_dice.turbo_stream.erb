<%= turbo_stream.replace "shop" do %>
  <%= turbo_frame_tag "shop" do %>
    <%= render "shop", match: @match %>
  <% end %>
<% end %>

<%= turbo_stream.replace dom_id(@match.active_player) do %>
  <%= turbo_frame_tag dom_id(@match.active_player) do %>
    <%= render "player_panel", player: @match.active_player, match: @match %>
  <% end %>
<% end %>
