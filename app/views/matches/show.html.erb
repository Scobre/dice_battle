<h1>Match <%= @match.id %></h1>

<% if @match.finished? %>

  <h1>
    🏆
    Winner:
    <%= @match.winner.name %>
  </h1>

<% else %>

  <%= turbo_frame_tag "active_player" do %>
    <%= render "active_player", match: @match %>
  <% end %>

  <hr>

  <h2>Shop</h2>

  <%= turbo_frame_tag "shop" do %>
    <%= render "shop", match: @match %>
  <% end %>

  <hr>

  <div class="players">

    <% @match.players.order(:position).each do |player| %>

      <%= turbo_frame_tag dom_id(player) do %>
        <%= render "player_panel", player: player, match: @match %>
      <% end %>

    <% end %>

  </div>
<% end %>